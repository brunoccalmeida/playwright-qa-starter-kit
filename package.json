{
  "name": "playwright-qa-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Playwright + TypeScript QA starter kit: E2E and API tests, CI on GitHub Actions and a published HTML report.",
  "author": "Bruno Almeida",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:deps",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "check:deps": "node scripts/check-dependency-ignores.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/semver": "7.8.0",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "2.12.2",
    "prettier": "3.9.10",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
